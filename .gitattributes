# Normalize line endings so diffs do not churn between Windows and CI.
* text=auto eol=lf

# Vendored upstream content: never normalized. Any transformation would change
# the sha256 recorded in sources.lock.json and fail verify_core.py.
skill-core/vendor/** -text

# Generated projection: same reasoning -- projected SKILL.md files are hashed
# against the lock by project_skills.py.
.agents/skills/** -text

*.ps1 text eol=crlf
*.py  text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.jsonl text eol=lf
